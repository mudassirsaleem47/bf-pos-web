generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  settings         Setting?
  suppliers        Supplier[]
  categories       Category[]
  warehouses       Warehouse[]
  products         Product[]
  saleTransactions SaleTransaction[]
  supplierInvoices SupplierInvoice[]
  customers        Customer[]
  expenses         Expense[]
  loans            Loan[]
  staff            Staff[]
}

model Setting {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String   @default("My Store")
  address       String?
  phone         String?
  email         String?
  website       String?
  logoPath      String?
  taxRate       Float    @default(0)
  currency      String   @default("Rs.")
  receiptFooter String   @default("Thank you! Come again")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Supplier {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  products      Product[]
  invoices      SupplierInvoice[]
}

model Category {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  products    Product[]

  @@unique([userId, name])
}

model Warehouse {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  capacity  Int?
  manager   String?
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  products  Product[]
  invoices  SupplierInvoice[]

  @@unique([userId, name])
}

model Product {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  barcode       String
  price         Float      @default(0)
  stock         Float      @default(0)
  unit          String     @default("pcs")
  expiryDate    DateTime?
  categoryId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  detail        String?
  imagePath     String?
  lowStockAlert Float?     @default(5)
  mfgDate       DateTime?
  model         String?
  rackNo        String?
  supplierId    String?
  supplierPrice Float?     @default(0)
  warehouseId   String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  supplier      Supplier?  @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  saleItems     SaleItem[]

  @@unique([userId, barcode])
}

model SaleTransaction {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptNo   String
  totalAmount Float      @default(0)
  paidAmount  Float      @default(0)
  change      Float      @default(0)
  discount    Float      @default(0)
  tax         Float      @default(0)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  items       SaleItem[]

  @@unique([userId, receiptNo])
}

model SaleItem {
  id        String          @id @default(uuid())
  saleId    String
  productId String?
  name      String
  barcode   String?
  quantity  Float
  price     Float
  discount  Float           @default(0)
  total     Float
  product   Product?        @relation(fields: [productId], references: [id])
  sale      SaleTransaction @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SupplierInvoice {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNo   String
  supplierId  String
  warehouseId String
  date        DateTime
  imagePath   String?
  grandTotal  Float                 @default(0)
  paidAmount  Float                 @default(0)
  due         Float                 @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  items       SupplierInvoiceItem[]

  @@unique([userId, invoiceNo])
}

model SupplierInvoiceItem {
  id        String          @id @default(uuid())
  invoiceId String
  itemName  String
  quantity  Float
  rate      Float
  total     Float
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  loyaltyPoints Int               @default(0)
  balance       Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  sales         SaleTransaction[]
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Loan {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerName  String
  type         String
  amount       Float
  interestRate Float    @default(0)
  dueDate      DateTime
  status       String   @default("Active")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Staff {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String
  salary    Float
  dateHired DateTime
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SyncLog {
  id        String   @id @default(uuid())
  userId    String?
  modelName String
  recordId  String
  action    String
  createdAt DateTime @default(now())
}
